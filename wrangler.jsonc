// Cloudflare Worker com static assets: public/ é servido direto; /api/* vai para src/worker.js (grava no D1).
{
  "name": "sts-xai-questionario",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcc_quest",
      "database_id": "49c26314-9560-4597-8193-925469f9d9a3",
      "migrations_dir": "migrations"
    }
  ]
}
